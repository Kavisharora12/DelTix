# =============================================================================
# DELTIX — Unified Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials before starting services.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PAYPAL AGENT TOOLKIT & DEVELOPER SANDBOX KEYS
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=[YOUR_PAYPAL_SANDBOX_CLIENT_ID]
PAYPAL_CLIENT_SECRET=[YOUR_PAYPAL_SANDBOX_CLIENT_SECRET]
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# -----------------------------------------------------------------------------
# 2. GOOGLE GEMINI API KEY (Compiler :8081 & LangGraph Worker :8085)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash
GEMINI_RPM_PER_MODEL=15
GEMINI_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL (ACID Relational State & Capability Registry)
# -----------------------------------------------------------------------------
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_MAX_CONNS=15
SUPABASE_DB_MIN_CONNS=2
SUPABASE_USE_SIMPLE_PROTOCOL=true

# -----------------------------------------------------------------------------
# 4. UPSTASH REDIS (OAuth Sessions, Sliding-Window Rate Limits & Run Locks)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_URL=rediss://default:[YOUR_UPSTASH_TOKEN]@[YOUR_ENDPOINT].upstash.io:6379

# -----------------------------------------------------------------------------
# 5. GOOGLE OAUTH2 (API Gateway User Authentication)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=[YOUR_GOOGLE_OAUTH_CLIENT_ID].apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=[YOUR_GOOGLE_OAUTH_CLIENT_SECRET]
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

# -----------------------------------------------------------------------------
# 6. CRYPTOGRAPHIC HMAC SECRETS (Compiler Readiness & Human Approval Tokens)
# -----------------------------------------------------------------------------
READINESS_HMAC_SECRET=replace-with-32-byte-hmac-readiness-secret-key
APPROVAL_HMAC_SECRET=replace-with-32-byte-hmac-approval-secret-key

# -----------------------------------------------------------------------------
# 7. SERVICE PORTS & INTERNAL DISCOVERY URLS
# -----------------------------------------------------------------------------
GATEWAY_HTTP_PORT=8080
GATEWAY_RATE_LIMIT_PER_MIN=100
GATEWAY_COOKIE_SECURE=false

COMPILER_HTTP_PORT=8081
RUNTIME_HTTP_PORT=8082
MEMORY_HTTP_PORT=8083
CAPABILITY_HTTP_PORT=8084
WORKER_HTTP_PORT=8085

COMPILER_SERVICE_URL=http://localhost:8081
RUNTIME_SERVICE_URL=http://localhost:8082
MEMORY_SERVICE_URL=http://localhost:8083
CAPABILITY_POLICY_SERVICE_URL=http://localhost:8084
WORKER_BRIDGE_URL=http://localhost:8085
