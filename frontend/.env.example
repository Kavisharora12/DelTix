# =============================================================================
# DELTIX FRONTEND — Environment Configuration (.env.example)
# NOTE: DelTix frontend uses Next.js 14 (not Vite), so browser-exposed vars
# must use the NEXT_PUBLIC_ prefix. No backend secrets belong here.
# =============================================================================

# Public browser API base path.
# Using "/api/gateway" routes browser traffic through Next.js -> Docker bridge
# network -> http://api-gateway:8080 (so internal backend services stay hidden).
NEXT_PUBLIC_API_URL=/api/gateway

# Server-side proxy target used by Next.js (/src/app/api/gateway/[...path]/route.ts):
# - Local `npm run dev` on host: http://localhost:8080
# - Inside Docker Compose bridge network: http://api-gateway:8080 (injected in compose)
API_GATEWAY_INTERNAL_URL=http://localhost:8080

# UI default environment badge ("SANDBOX" or "LIVE")
NEXT_PUBLIC_APP_ENV=SANDBOX
