# Service 3 (Python LangGraph Worker): DelTix Runtime Worker (:8085)
# Note: The worker also automatically loads the root d:\PayPal\DelTix\.env file.
WORKER_HTTP_PORT=8085

# PayPal Agent Toolkit (https://developer.paypal.com/ai-tools/toolkit/)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Google Gemini Models & Sliding Window Rate Limiter
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash
GEMINI_RPM_PER_MODEL=15
GEMINI_WINDOW_SECONDS=60

CAPABILITY_POLICY_SERVICE_URL=http://localhost:8084
MEMORY_SERVICE_URL=http://localhost:8083
